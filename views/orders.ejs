<div class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-3xl font-bold mb-8">Riwayat Pesanan</h1>

  <% if (typeof success_msg !== 'undefined' && success_msg) { %>
    <div class="flash-success p-4 rounded-xl mb-6"><%= success_msg %></div>
  <% } %>

  <% if (orders && orders.length > 0) { %>
    <% orders.forEach(function(o) { %>
      <div class="card p-6 mb-4 flex justify-between items-center">
        <div>
          <span class="font-mono text-xs text-gray-400"><%= o.order_number %></span>
          <h3 class="font-bold"><%= o.product %> - <%= o.package %></h3>
          <p class="text-sm text-gray-600">Rp <%= Number(o.amount).toLocaleString('id-ID') %></p>
          <% if (o.license_key) { %>
            <p class="text-xs font-mono text-blue-600 mt-1">Lisensi: <%= o.license_key %></p>
          <% } %>
        </div>
        <div class="text-right">
          <% if (o.payment_status === 'pending') { %>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-800">Menunggu Konfirmasi</span>
            <p class="text-xs text-gray-400 mt-1">Hubungi admin untuk pembayaran</p>
          <% } else { %>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">Aktif</span>
            <% if (o.license_key) { %>
              <a href="/cek-lisensi?key=<%= o.license_key %>" class="text-xs text-blue-600 block mt-1">Cek Lisensi</a>
            <% } %>
          <% } %>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="card p-12 text-center">
      <i class="fa-solid fa-receipt text-4xl text-gray-300 mb-4"></i>
      <p class="text-gray-600 mb-4">Belum ada pesanan.</p>
      <a href="/beli" class="btn-primary">Beli Lisensi</a>
    </div>
  <% } %>
</div>
