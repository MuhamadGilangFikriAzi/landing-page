<div class="max-w-7xl mx-auto px-4 py-10">
  <h1 class="text-3xl font-bold mb-8">Pengguna</h1>
  <div class="card overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50"><tr>
        <th class="text-left p-4 font-semibold">Nama</th><th class="text-left p-4 font-semibold">Email</th>
        <th class="text-left p-4 font-semibold">Role</th><th class="text-left p-4 font-semibold">Tanggal</th>
      </tr></thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr class="border-t border-gray-100">
            <td class="p-4 font-medium"><%= u.name %></td>
            <td class="p-4"><%= u.email %></td>
            <td class="p-4"><span class="px-3 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-800"><%= u.role %></span></td>
            <td class="p-4 text-xs text-gray-500"><%= new Date(u.created_at).toLocaleDateString('id-ID') %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>