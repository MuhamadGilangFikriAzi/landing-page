<div class="max-w-7xl mx-auto px-4 py-10">
  <h1 class="text-3xl font-bold mb-8">Admin Dashboard</h1>
  <div class="grid md:grid-cols-4 gap-6 mb-10">
    <div class="card p-6"><p class="text-gray-500 text-sm">Lisensi</p><p class="text-3xl font-bold"><%= totalLicenses %></p></div>
    <div class="card p-6"><p class="text-gray-500 text-sm">Aktif</p><p class="text-3xl font-bold text-emerald-600"><%= activeLicenses %></p></div>
    <div class="card p-6"><p class="text-gray-500 text-sm">Pesanan</p><p class="text-3xl font-bold"><%= totalOrders %></p></div>
    <div class="card p-6"><p class="text-gray-500 text-sm">Revenue</p><p class="text-3xl font-bold text-blue-600">Rp <%= totalRevenue.toLocaleString('id-ID') %></p></div>
  </div>
  <div class="grid md:grid-cols-2 gap-6">
    <div class="card p-6">
      <h3 class="font-bold mb-4">Lisensi Terbaru</h3>
      <% recentLicenses.forEach(function(l) { %>
        <div class="flex justify-between border-b border-gray-100 py-2 text-sm">
          <span class="font-mono"><%= l.license_key.substring(0,16) %>...</span>
          <span class="px-2 rounded-full text-xs bg-emerald-100 text-emerald-800"><%= l.status %></span>
        </div>
      <% }); %>
    </div>
    <div class="card p-6">
      <h3 class="font-bold mb-4">Menu</h3>
      <div class="space-y-2">
        <a href="/admin/licenses" class="block p-3 rounded-xl bg-gray-50 hover:bg-gray-100 font-medium"> Kelola Lisensi</a>
        <a href="/admin/orders" class="block p-3 rounded-xl bg-gray-50 hover:bg-gray-100 font-medium"> Kelola Pesanan</a>
        <a href="/admin/users" class="block p-3 rounded-xl bg-gray-50 hover:bg-gray-100 font-medium"> Kelola User</a>
      </div>
    </div>
  </div>
</div>