<div class="max-w-7xl mx-auto px-4 py-10">
  <h1 class="text-3xl font-bold mb-8">Lisensi</h1>
  <div class="card overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50"><tr>
        <th class="text-left p-4 font-semibold">Key</th><th class="text-left p-4 font-semibold">Customer</th>
        <th class="text-left p-4 font-semibold">Produk</th><th class="text-left p-4 font-semibold">Paket</th>
        <th class="text-left p-4 font-semibold">Device</th><th class="text-left p-4 font-semibold">Status</th>
      </tr></thead>
      <tbody>
        <% licenses.forEach(function(l) { %>
          <tr class="border-t border-gray-100">
            <td class="p-4 font-mono text-xs"><%= l.license_key %></td>
            <td class="p-4"><%= l.customer_name %><br><span class="text-xs text-gray-500"><%= l.customer_email %></span></td>
            <td class="p-4"><%= l.app === 'suruhkelola' ? 'SuruhKelola' : 'SuruhLaundry' %></td>
            <td class="p-4"><%= l.package %></td>
            <td class="p-4"><%= JSON.parse(l.activated_devices || '[]').length %>/<%= l.max_devices %></td>
            <td class="p-4"><span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800"><%= l.status %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>